# >>> control-center theme >>>
[[ -f ~/control.env ]] && source ~/control.env
export JAVA_HOME="$HOME/.local/lib/jdk17"
command -v direnv &>/dev/null && eval "$(direnv hook bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"
[[ -f ~/.bashrc.d/control.sh ]] && source ~/.bashrc.d/control.sh
[[ -f ~/.bashrc.d/welcome.sh ]] && source ~/.bashrc.d/welcome.sh
[[ "${CONTROL_VENV_AUTOLOAD:-1}" != "0" && -f ~/.venv/bin/activate && -z "$VIRTUAL_ENV" ]] \
  && source ~/.venv/bin/activate
# <<< control-center theme <<<
