[user]
	name = obtstar
	email = dev@obtstar.com
[core]
	editor = vim
	autocrlf = input
	quotepath = false
	longpaths = true
	ignorecase = false
[color]
	ui = auto
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	last = log -1 HEAD
	lg = log --oneline --graph --decorate --all
	wt = worktree
[push]
	default = simple
[pull]
	rebase = false
[init]
	defaultBranch = main
