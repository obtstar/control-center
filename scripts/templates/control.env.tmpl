# control.env — Agent 平台环境变量（13/15 章），由 setup-env.sh 按模板渲染
export CONTROL_HOME="$BASE_HOME/control-center"
export REPOS_GITDIR="$BASE_HOME/.repos"
export WORKTREE_ROOT="$BASE_HOME/wt"
export CONTROL_DATA="$BASE_HOME/data"
export CONTROL_LOGS="$BASE_HOME/logs"
export LITELLM_ENDPOINT="$LITELLM_ENDPOINT"
# openwiki（可选文档生产器）：关遥测 + provider 指向 LiteLLM 网关
export OPENWIKI_TELEMETRY_DISABLED=1
export OPENWIKI_PROVIDER=openai-compatible
export OPENAI_COMPATIBLE_BASE_URL="$LITELLM_ENDPOINT/v1"
export OPENWIKI_MODEL_ID=cheap
# export LITELLM_API_KEY=    # 密钥不落盘，按需填入或经密钥管理注入（OPENAI_COMPATIBLE_API_KEY 同值复用）
# export PIEKBS_API_KEY=     # PieKBS REST 面（/api/* + /mcp）Bearer 认证密钥（FINDING-030；启用后 Web UI 的 JS 调 /api 需自行带头）
# export CONTROL_KB_API_KEY= # control-api 调 PieKBS 时携带的同值密钥（与 PIEKBS_API_KEY 成对设置）
# export NPM_REGISTRY=       # npm 内网镜像，如 http://npm.internal:4873
# export PIP_INDEX_URL=      # pip 内网镜像，如 http://pypi.internal/simple
